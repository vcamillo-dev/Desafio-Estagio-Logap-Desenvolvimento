# O Docker local inicia em modo demonstração sem autenticação.
# Essas variáveis são usadas no frontend hospedado (Render), onde o login é obrigatório.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Deixe vazio para o Docker local. No frontend hospedado, informe a URL pública da API.
VITE_API_BASE_URL=

# No ambiente hospedado, substitua pelas origens exatas autorizadas no CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Alvo do proxy do Vite no desenvolvimento; por padrão usa o serviço do Docker.
VITE_DEV_API_TARGET=http://app:8080
